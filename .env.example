# GigaChat (Sber) — required for the SOC AI analyzer
# Get the key in https://developers.sber.ru/studio
GIGACHAT_CREDENTIALS=
# Auth scope for your GigaChat key: GIGACHAT_API_PERS (personal) or
# GIGACHAT_API_CORP / GIGACHAT_API_B2B (business). Defaults to
# GIGACHAT_API_PERS when unset.
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Corporate / MITM CA: leave false unless you have a proper bundle
GIGACHAT_VERIFY_SSL_CERTS=false
# GIGACHAT_CA_BUNDLE_FILE=

# Optional NekoWatch overrides (NEKOWATCH_ prefix)
# Prefer editing config/sources.yaml for Wazuh paths (alerts.json / alerts.log / archives.json).
# NEKOWATCH_SOURCES_CONFIG=config/sources.yaml
# NEKOWATCH_LOG_FILE=/tmp/wazuh_logs/wazuh_alerts.json   # fallback if sources.yaml empty
# NEKOWATCH_GENERATOR_AUTOSTART=true
# NEKOWATCH_SOURCE_EVENT_TIMEOUT_SECONDS=60
# NEKOWATCH_STATUS_PING_MOCK=true
# NEKOWATCH_STATUS_PING_MOCK=false   # real ICMP against LAN IPs
# NEKOWATCH_STATUS_MONITOR_ENABLED=true

# Real-time API import
# NEKOWATCH_INGEST_PUSH_ENABLED=true
# NEKOWATCH_INGEST_PUSH_TOKEN=change-me          # X-NekoWatch-Token / Bearer
# NEKOWATCH_API_INGEST_ENABLED=true              # pollers from sources.yaml api_active
# NEKOWATCH_API_INGEST_TIMEOUT=30
# NEKOWATCH_API_INGEST_MAX_BATCH=500
# Per-source secrets (name from api_sources in sources.yaml):
# NEKOWATCH_API_SOURCE_WAZUH_MANAGER_PASSWORD=
# NEKOWATCH_API_SOURCE_WAZUH_MANAGER_TOKEN=
# NEKOWATCH_API_SOURCE_HTTP_JSON_TOKEN=
